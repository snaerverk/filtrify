query
    = expr ;

expr
    = or_expr ;

or_expr
    = and_expr { "or" and_expr } ;

and_expr
    = unary_expr { unary_expr } ;

unary_expr
    = [ "not" ] primary ;

primary
    = comparison
    | function
    | has_expr
    | "(" expr ")" ;

comparison
    = identifier operator literal ;

function
    = identifier "(" arguments ")" ;

has_expr
    = "has" "(" identifier "," expr ")" ;

arguments
    = expr { "," expr } ;

operator
    = "=" | "!=" | ">" | ">=" | "<" | "<=" ;

literal
    = string
    | number
    | boolean ;

identifier
    = letter { letter | digit | "_" | "." } ;