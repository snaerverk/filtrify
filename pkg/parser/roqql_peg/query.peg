{
    package roqql

    import (
        "strconv"
        astv1 "github.com/snaerverk/filtrify/pkg/generated/filtrify/ast/v1"
    )
}

Expr
    <- OrExpr

OrExpr
    <- head:AndExpr tail:OrTail {
        return buildOr(head, tail)
    }

OrTail
    <- tail:(WS "OR" WS AndExpr)* {
        return buildOrTail(tail)
    }

AndExpr
    <- head:Unary tail:AndTail {
        return buildAnd(head, tail)
    }

AndTail
    <- tail:(WS "AND" WS Unary)* {
        return buildAndTail(tail)
    }

Unary
    <- "NOT" WS x:Unary {
        return buildNot(x)
    }
    / Primary

Primary
    <- "(" WS expr:Expr WS ")" {
        return expr, nil
    }
    / Has
    / Contains
    / In
    / Comparison

Contains
    <- "contains" WS "(" WS field:(Ident / String) WS "," WS value:Value WS ")" {
        return buildContains(field, value)
    }

In
    <- "in" WS "(" WS field:(Ident / String) WS "," WS values:List WS ")" {
        return buildIn(field, values)
    }

CommaValue
    <- WS "," WS v:Value {
        return v, nil
    }

List
    <- "[" WS first:Value rest:CommaValue* WS "]" {
        return buildList(first, rest)
    }

Has
    <- "has" WS "(" WS entity:Ident WS "," WS expr:Expr WS ")" {
        return buildHas(entity, expr)
    }

Comparison
    <- field:Ident WS op:Op WS value:Value {
        return buildComparison(field, op, value)
    }

Op
    <- (">=" / "<=" / "!=" / ">" / "<" / "=") {
        return string(c.text), nil
    }
    / ("" { return "", nil })

Value
    <- v:(Bool / Number / String) {
        return v, nil
    }

Bool
    <- "true" {
        return &astv1.Value{Value: &astv1.Value_Bool{Bool: true}}, nil
    }
    / "false" {
        return &astv1.Value{Value: &astv1.Value_Bool{Bool: false}}, nil
    }

Number
    <- val:[0-9]+ {
        s, err := toString(val)
        if err != nil {
            return nil, err
        }
        v, _ := strconv.ParseInt(s, 10, 64)
        return &astv1.Value{
            Value: &astv1.Value_Integer{Integer: v},
        }, nil
    }

Ident       <- [a-zA-Z_][a-zA-Z0-9_]* {
        return string(c.text), nil
    }

String      <- ( '"' StringChar* '"' / "'" StringChar* "'" ) {
        s := string(c.text)
        if len(s) >= 2 {
            s = s[1 : len(s)-1]
        }
        return &astv1.Value{
            Value: &astv1.Value_String_{String_: s},
        }, nil
    }

StringChar  <- !["'] .

WS          <- [ \t\n\r]* {
        return nil, nil
    }