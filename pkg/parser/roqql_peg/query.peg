{
    package roqql

    import (
        astv1 "github.com/snaerverk/filtrify/pkg/generated/filtrify/ast/v1"
    )
}

// Query is the entry point. It must consume the whole input: a filter that
// silently stopped at the first unparsable token would match more than asked.
Query
    <- WS expr:Expr WS EOF {
        return expr, nil
    }

Expr
    <- OrExpr

OrExpr
    <- head:AndExpr tail:OrTail {
        return buildOr(head, tail)
    }

OrTail
    <- tail:(WS OrKw WS AndExpr)* {
        return buildOrTail(tail)
    }

AndExpr
    <- head:Unary tail:AndTail {
        return buildAnd(head, tail)
    }

AndTail
    <- tail:(WS AndKw WS Unary)* {
        return buildAndTail(tail)
    }

Unary
    <- NotKw WS x:Unary {
        return buildNot(x)
    }
    / Primary

Primary
    <- "(" WS expr:Expr WS ")" {
        return expr, nil
    }
    / Has
    / Contains
    / In
    / Comparison

Contains
    <- "contains"i WS "(" WS field:(Ident / String) WS "," WS value:Value WS ")" {
        return buildContains(field, value)
    }

In
    <- "in"i WS "(" WS field:(Ident / String) WS "," WS values:List WS ")" {
        return buildIn(field, values)
    }

CommaValue
    <- WS "," WS v:Value {
        return v, nil
    }

List
    <- "[" WS first:Value rest:CommaValue* WS "]" {
        return buildList(first, rest)
    }

Has
    <- "has"i WS "(" WS entity:Ident WS "," WS expr:Expr WS ")" {
        return buildHas(entity, expr)
    }

// The operator is required: "field value" is a syntax error, not equality.
Comparison
    <- field:Ident WS op:Op WS value:Value {
        return buildComparison(field, op, value)
    }

Op
    <- (">=" / "<=" / "!=" / ">" / "<" / "=") {
        return string(c.text), nil
    }

Value
    <- v:(Bool / Number / String) {
        return v, nil
    }

Bool
    <- "true"i !IdentChar {
        return &astv1.Value{Value: &astv1.Value_Bool{Bool: true}}, nil
    }
    / "false"i !IdentChar {
        return &astv1.Value{Value: &astv1.Value_Bool{Bool: false}}, nil
    }

Number
    <- '-'? [0-9]+ ('.' [0-9]+)? !IdentChar {
        return buildNumber(string(c.text))
    }

// Keywords are case-insensitive and must not run into an identifier, so
// "notes = 1" is a comparison on "notes", not NOT "es = 1".
AndKw <- "and"i !IdentChar
OrKw  <- "or"i !IdentChar
NotKw <- "not"i !IdentChar

Ident       <- [a-zA-Z_] IdentChar* {
        return string(c.text), nil
    }

IdentChar   <- [a-zA-Z0-9_]

// Strings take either quote; a backslash escapes the next quote or backslash.
String      <- ( '"' DQChar* '"' / "'" SQChar* "'" ) {
        return buildString(string(c.text))
    }

DQChar      <- '\\' ["'\\] / !["\\] .
SQChar      <- '\\' ["'\\] / !['\\] .

WS          <- [ \t\n\r]* {
        return nil, nil
    }

EOF         <- !.
